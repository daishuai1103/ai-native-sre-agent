# ============================================
# AI Native SRE Agent 环境变量模板
# 使用方法：复制为 .env，然后修改对应值
# ============================================

# ---------- LLM 配置 ----------
# OpenAI 兼容 API 的 Key（必填）
OPENAI_API_KEY=your_api_key_here

# API Base URL（默认官方 OpenAI，用第三方就改）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称
OPENAI_MODEL=gpt-4o-mini

# ---------- Agent 配置 ----------
# DRY_RUN 模式：true=只模拟不真的执行（安全），false=真正执行修复动作
AGENT_DRY_RUN=true

# ---------- 服务配置 ----------
# 后端服务端口
SERVER_PORT=8081

# Prometheus 地址
PROMETHEUS_URL=http://localhost:9090

# NetBox API Token（可选，用于 netbox_query 工具）
NETBOX_API_TOKEN=

# ---------- 告警巡检配置 ----------
# 是否开启自动告警巡检（true=开启，false=关闭，手动演示用）
ALERTER_ENABLED=false

# 巡检间隔（秒）
ALERTER_INTERVAL=30

# ---------- 智能路由配置 ----------
# ONNX 模型路径（ONNX 模式才需要）
ONNX_MODEL_PATH=internal/router/model.onnx

# 词典路径
ONNX_VOCAB_PATH=internal/router/vocab.json

# 路由置信度阈值（低于此值回退到规则路由）
ROUTER_THRESHOLD=0.6
